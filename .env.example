SUPERAGENT_ENV=development
SUPERAGENT_DEBUG=true
SUPERAGENT_APP_HOST=127.0.0.1
SUPERAGENT_APP_PORT=8000
SUPERAGENT_LOG_LEVEL=INFO
SUPERAGENT_DATABASE_PATH=data/superagent.sqlite3
SUPERAGENT_STORAGE_PATH=data/storage

# API identity boundary.
# Local-first single-user mode: set an explicit stable principal ID.
SUPERAGENT_DEFAULT_PRINCIPAL_ID=
# Production/reverse-proxy mode: only enable this when the proxy strips and
# rewrites X-SuperAgent-Principal from a verified authenticated identity.
SUPERAGENT_TRUST_PRINCIPAL_HEADER=false

# LLM: any OpenAI-compatible chat-completions server/API.
# Examples: local llama.cpp, LM Studio, Ollama-compatible gateway, vLLM,
# OpenAI, or another hosted provider exposing the same contract.
SUPERAGENT_LLM_PROVIDER=openai_compatible
SUPERAGENT_LLM_BASE_URL=http://127.0.0.1:8080
SUPERAGENT_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
SUPERAGENT_LLM_HEALTH_PATH=/health
SUPERAGENT_LLM_MODEL_ID=
SUPERAGENT_PROVIDER_API_KEY=
SUPERAGENT_LLM_TEMPERATURE=0.7
SUPERAGENT_LLM_MAX_OUTPUT_TOKENS=1024
SUPERAGENT_CONTEXT_WINDOW_TOKENS=8192
SUPERAGENT_TOOLS_ENABLED=true
SUPERAGENT_STRUCTURED_OUTPUT_ENABLED=true

# Optional local llama.cpp compatibility mode. The same generic settings
# above are still used; this only selects the legacy provider adapter.
# SUPERAGENT_LLM_PROVIDER=llama_cpp

SUPERAGENT_EMBEDDING_BASE_URL=http://127.0.0.1:8081
SUPERAGENT_RERANKER_BASE_URL=http://127.0.0.1:8082
SUPERAGENT_EMBEDDING_MODEL_ID=
SUPERAGENT_RERANKER_MODEL_ID=
SUPERAGENT_PROVIDER_CONNECT_TIMEOUT_SECONDS=5.0
SUPERAGENT_PROVIDER_READ_TIMEOUT_SECONDS=30.0
SUPERAGENT_PROVIDER_TOTAL_TIMEOUT_SECONDS=60.0
SUPERAGENT_PROVIDER_RETRY_COUNT=2
SUPERAGENT_PROVIDER_RETRY_BACKOFF_SECONDS=0.5
SUPERAGENT_WEB_PROVIDER=stub
SUPERAGENT_WEB_PROVIDER_BASE_URL=https://example.invalid
SUPERAGENT_MAX_MODEL_CALLS=4
SUPERAGENT_MAX_TOOL_CALLS=8
SUPERAGENT_MAX_RETRIES=2
SUPERAGENT_MAX_EXECUTION_TIME_SECONDS=60
SUPERAGENT_LEARNING_ENABLED=true
SUPERAGENT_DAILY_REVIEW_LIMIT=50
SUPERAGENT_NEW_CARDS_PER_DAY=20
SUPERAGENT_MAX_GENERATED_CARDS=5
SUPERAGENT_LEARNING_CONTEXT_BUDGET=1500
