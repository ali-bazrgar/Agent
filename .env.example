SUPERAGENT_MAX_EXECUTION_TIME_SECONDS=60
SUPERAGENT_LEARNING_ENABLED=true
SUPERAGENT_DAILY_REVIEW_LIMIT=50
SUPERAGENT_NEW_CARDS_PER_DAY=20
SUPERAGENT_MAX_GENERATED_CARDS=5
SUPERAGENT_LEARNING_CONTEXT_BUDGET=1500
